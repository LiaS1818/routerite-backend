{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"deleteOutDir": true,
		"assets": [
			{
				"include": "../.api/**/*.json",
				"outDir": "dist/.api",
				"watchAssets": true
			},
			{
				"include": "../views/**/*.hbs",
				"outDir": "dist/views/",
				"watchAssets": true
			}
		]
	}
}
